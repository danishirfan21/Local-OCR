# --- Deep Analyze (production) ---
#
# Local Lens's production Deep Analyze feature uses Gemini only, frozen to
# gemini-3.1-flash-lite (see docs/V5_GEMINI_DEEP.md for why). Leave this
# unset and Fast mode (fully local, EasyOCR) works exactly as before --
# Deep Analyze just shows as "not configured" in the UI/CLI. Get a key
# from Google AI Studio (see README.md "Deep Analyze" for the link).
# Never commit a real .env.
LOCAL_LENS_GEMINI_API_KEY=


# --- Deep Analyze provider BAKE-OFF (local-lens benchmark-deep) ---
#
# Developer/CI tooling only -- separate from the production key above on
# purpose, so a benchmark credential can never be mistaken for production
# config or vice versa. See docs/REMOTE_BENCHMARK_EXECUTION.md before
# setting any of these: `local-lens benchmark-deep --preflight` reports
# what's configured and the estimated maximum cost WITHOUT making any
# request; `--run` requires --confirm-remote and --max-cost-usd (or
# --free-tier-only for the free round) and makes real requests once you
# approve it.

# Round 1 (free) -- see docs/DEEP_PROVIDER_EVALUATION.md "Free-first strategy"
LOCAL_LENS_BENCHMARK_GROQ_API_KEY=
LOCAL_LENS_BENCHMARK_GEMINI_API_KEY=

# Round 2 (paid, $0.25 hard ceiling) -- requires --run --confirm-remote --max-cost-usd
LOCAL_LENS_BENCHMARK_OPENAI_API_KEY=
LOCAL_LENS_BENCHMARK_ANTHROPIC_API_KEY=
LOCAL_LENS_BENCHMARK_FIREWORKS_API_KEY=


# --- Deep Analyze (legacy generic BYOK -- internal extensibility only) ---
#
# The original multi-provider config (any OpenAI-compatible/Anthropic/
# self-hosted-Paddle-vLLM endpoint). Not used by the production app/CLI
# "Deep Analyze" feature as of V5 (that's LOCAL_LENS_GEMINI_API_KEY above)
# -- kept for internal/advanced use of the DeepAnalysisProvider abstraction.
LOCAL_LENS_DEEP_PROVIDER=openai-compatible
LOCAL_LENS_DEEP_BASE_URL=
LOCAL_LENS_DEEP_API_KEY=
LOCAL_LENS_DEEP_MODEL=
