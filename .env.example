# Deep Analyze is optional and bring-your-own-endpoint (BYOK). Local Lens
# does not operate any inference infrastructure and ships with no default
# provider, base URL, or API key. Leave these unset and Fast mode (fully
# local, EasyOCR) works exactly as before -- Deep Analyze just shows as
# "not configured" in the UI/CLI.
#
# Copy this file to .env (or export the variables another way) and fill in
# your own remote endpoint to enable Deep Analyze. Never commit a real .env.

# "openai-compatible" (default) or "paddle-vllm"
LOCAL_LENS_DEEP_PROVIDER=openai-compatible

# Base URL of an OpenAI-compatible /v1/chat/completions endpoint -- e.g. a
# self-hosted vLLM server, or a hosted OpenAI-compatible VLM provider.
LOCAL_LENS_DEEP_BASE_URL=

# Optional -- omit for an unauthenticated server.
LOCAL_LENS_DEEP_API_KEY=

# Optional -- defaults to a sensible model name per provider
# (gpt-4o-mini for openai-compatible, PaddleOCR-VL-1.6 for paddle-vllm).
LOCAL_LENS_DEEP_MODEL=
